{
  "name": "@score/gui",
  "version": "0.0.1",
  "private": true,
  "description": "Score Studio — DAW, live coding, and DJ set GUI",
  "main": "out/main/index.js",
  "scripts": {
    "dev":           "electron-vite dev",
    "build":         "electron-vite build",
